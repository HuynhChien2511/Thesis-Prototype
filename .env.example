# ========================================================
# CẤU HÌNH MẪU HỆ THỐNG TRỢ LÝ HÀNH CHÍNH CÔNG (PROTOTYPE)
# Hướng dẫn: Đổi tên tệp này thành .env và điền API Key của bạn
# ========================================================

# Lựa chọn nhà cung cấp LLM: "gemini", "openai" hoặc "ollama"
LLM_PROVIDER=gemini

# --------------------------------------------------------
# 1. Google Gemini Configuration (Khuyến nghị cho Free Tier)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
# --------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --------------------------------------------------------
# 2. OpenAI Configuration (Nếu dùng LLM_PROVIDER=openai)
# --------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --------------------------------------------------------
# 3. Ollama Configuration (Nếu dùng LLM_PROVIDER=ollama offline)
# --------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=bge-m3

# --------------------------------------------------------
# 4. Cấu hình Não bộ RAG (Retrieval-Augmented Generation)
# --------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SIMILARITY_THRESHOLD=0.55

# --------------------------------------------------------
# 5. Cấu hình Đôi tai STT (Faster-Whisper)
# Trên Laptop có GPU: STT_DEVICE=cuda, WHISPER_COMPUTE_TYPE=float16, WHISPER_MODEL=medium
# Trên Raspberry Pi: STT_DEVICE=cpu, WHISPER_COMPUTE_TYPE=int8, WHISPER_MODEL=base
# --------------------------------------------------------
WHISPER_MODEL=medium
STT_MODEL=medium
STT_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# --------------------------------------------------------
# 6. Cấu hình Khuôn miệng TTS (Microsoft Edge-TTS)
# Giọng đọc: vi-VN-HoaiMyNeural (Nữ) hoặc vi-VN-NamMinhNeural (Nam)
# --------------------------------------------------------
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
